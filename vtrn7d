-- JumpPower: impulso no pulo nativo, sem escrever propriedades do Humanoid.
do
    local tracked, stateConnection, pendingBoost
    local generation = 0
    local groundStates = {
        [Enum.HumanoidStateType.Running] = true,
        [Enum.HumanoidStateType.RunningNoPhysics] = true,
        [Enum.HumanoidStateType.Landed] = true,
    }

    local function cancelPending()
        if pendingBoost then pendingBoost:Disconnect(); pendingBoost = nil end
    end

    local function restore()
        generation = generation + 1
        cancelPending()
        if stateConnection then stateConnection:Disconnect(); stateConnection = nil end
        tracked = nil
    end

    local function blocked()
        return o.destroyed or not T.spoofJumpEnabled
            or T.flyEnabled or T.spoofWalkEnabled or T.ghostEnabled
            or T.noclipCarEnabled or T.vFlyEnabled
            or o.travelBusy or o.fixedTeleportBusy or o.pumpkinBelowActive
            or o.collectionBusy or (o.travel and o.travel.owner)
            or T.autoColetaEnabled or T.farmPartesEnabled or T.autoFarmLixeiroEnabled
            or T.autoFarmPescaEnabled or T.autoFarmPumpkinEnabled
            or o.robberyStarting or (o.robbery and (o.robbery.enabled or o.robbery.paused))
    end

    local function queueBoost(hum)
        if blocked() or pendingBoost then return end
        local root, character = isRoot(), LocalPlayer.Character
        if not root or root.Anchored or hum.Health <= 0 or hum.Sit or hum.PlatformStand then return end
        local token = generation
        pendingBoost = RunService.Heartbeat:Connect(LPH_NO_VIRTUALIZE(function()
            cancelPending()
            if token ~= generation or tracked ~= hum or blocked() then return end
            if LocalPlayer.Character ~= character or isRoot() ~= root or isCValid() ~= hum then return end
            if not root.Parent or root.Anchored or hum.Health <= 0 or hum.Sit or hum.PlatformStand then return end
            local state = hum:GetState()
            if state ~= Enum.HumanoidStateType.Jumping and state ~= Enum.HumanoidStateType.Freefall then return end
            local power = tonumber(T.spoofJumpPower)
            if not power or power ~= power or math.abs(power) == math.huge then return end
            power = math.clamp(power, 0, 150)
            local velocity, mass = root.AssemblyLinearVelocity, root.AssemblyMass
            local delta = power - velocity.Y
            if delta <= 0 or mass <= 0 or mass == math.huge then return end
            local ok, problem = pcall(function()
                root:ApplyImpulse(Vector3.new(0, delta * mass, 0))
            end)
            if not ok then warn("[VETERANO TEAM] Pulo: " .. tostring(problem)) end
        end))
    end

    function o.updateJumpPower(hum)
        if o.destroyed or not T.spoofJumpEnabled or not hum then
            if tracked or stateConnection or pendingBoost then restore() end
            return
        end
        if tracked == hum and stateConnection then return end
        restore()
        tracked = hum
        stateConnection = hum.StateChanged:Connect(function(previous, current)
            if tracked ~= hum then return end
            if current == Enum.HumanoidStateType.Dead then cancelPending(); return end
            if current == Enum.HumanoidStateType.Jumping and groundStates[previous] then
                queueBoost(hum)
            end
        end)
    end

    function o.setJumpPower(value)
        T.spoofJumpEnabled = value == true and not o.destroyed
        o.updateJumpPower(isCValid())
    end
    o.restoreJumpPower = restore
    o.uz = function() o.updateJumpPower(isCValid()) end
    handleReady(LocalPlayer.CharacterRemoving:Connect(restore))
end

