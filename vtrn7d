    local errorCode = tostring(data.error or "RESPOSTA_INVALIDA")
    local messages = {
        UNAUTHORIZED="Credencial de validação recusada pela API.",
        KEY_NOT_FOUND="Key não encontrada.", INVALID_KEY="Key inválida.",
        KEY_REQUIRED="Informe sua key.", EXPIRADA="Key expirada.",
