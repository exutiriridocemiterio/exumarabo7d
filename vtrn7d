-- JumpPower: impulso no pulo nativo, sem escrever propriedades do Humanoid.
-- Ativar/ajustar/desativar apenas gerencia o listener; nao move o personagem.
do
    local tracked, stateConnection, pendingBoost
    local generation = 0
    local groundStates = {
        [Enum.HumanoidStateType.Running] = true,
        [Enum.HumanoidStateType.RunningNoPhysics] = true,
        [Enum.HumanoidStateType.Landed] = true,
    }

    local function cancelPending()
        if pendingBoost then pendingBoost:Disconnect(); pendingBoost = nil end
    end

    local function restore()
        generation = generation + 1
        cancelPending()
        if stateConnection then stateConnection:Disconnect(); stateConnection = nil end
        tracked = nil
    end

    local function blocked()
        return o.destroyed or not T.spoofJumpEnabled
            or T.flyEnabled or T.spoofWalkEnabled or T.ghostEnabled
            or T.noclipCarEnabled or T.vFlyEnabled
            or o.travelBusy or o.fixedTeleportBusy or o.pumpkinBelowActive
            or o.collectionBusy or (o.travel and o.travel.owner)
            or T.autoColetaEnabled or T.farmPartesEnabled or T.autoFarmLixeiroEnabled
            or T.autoFarmPescaEnabled or T.autoFarmPumpkinEnabled
            or o.robberyStarting or (o.robbery and (o.robbery.enabled or o.robbery.paused))
    end

    local function queueBoost(hum)
        if blocked() or pendingBoost then return end
        local root, character = isRoot(), LocalPlayer.Character
        if not root or root.Anchored or hum.Health <= 0 or hum.Sit or hum.PlatformStand then return end
        local token = generation
        pendingBoost = RunService.Heartbeat:Connect(function()
            cancelPending()
            if token ~= generation or tracked ~= hum or blocked() then return end
            if LocalPlayer.Character ~= character or isRoot() ~= root or isCValid() ~= hum then return end
            if not root.Parent or root.Anchored or hum.Health <= 0 or hum.Sit or hum.PlatformStand then return end
            local state = hum:GetState()
            if state ~= Enum.HumanoidStateType.Jumping and state ~= Enum.HumanoidStateType.Freefall then return end
            local power = tonumber(T.spoofJumpPower)
            if not power or power ~= power or math.abs(power) == math.huge then return end
            power = math.clamp(power, 0, 65)
            local velocity, mass = root.AssemblyLinearVelocity, root.AssemblyMass
            local delta = power - velocity.Y
            if delta <= 0 or mass <= 0 or mass == math.huge then return end
            local ok, problem = pcall(function()
                root:ApplyImpulse(Vector3.new(0, delta * mass, 0))
            end)
            if not ok then warn("[VETERANO TEAM] Pulo: " .. tostring(problem)) end
        end)
    end

    function o.updateJumpPower(hum)
        if o.destroyed or not T.spoofJumpEnabled or not hum then
            if tracked or stateConnection or pendingBoost then restore() end
            return
        end
        if tracked == hum and stateConnection then return end
        restore()
        tracked = hum
        stateConnection = hum.StateChanged:Connect(function(previous, current)
            if tracked ~= hum then return end
            if current == Enum.HumanoidStateType.Dead then cancelPending(); return end
            if current == Enum.HumanoidStateType.Jumping and groundStates[previous] then
                queueBoost(hum)
            end
        end)
    end

    function o.setJumpPower(value)
        T.spoofJumpEnabled = value == true and not o.destroyed
        o.updateJumpPower(isCValid())
    end
    o.restoreJumpPower = restore
    o.uz = function() o.updateJumpPower(isCValid()) end
    handleReady(LocalPlayer.CharacterRemoving:Connect(restore))
end

-- ============================================================
-- NOCLIP
-- ============================================================
local sz, Nz, ez
do
    local leases = {}
    local originals = setmetatable({}, { __mode = "k" })
    local character
    local cachedParts, addedConnection, removingConnection = {}, nil, nil
    local function watchCharacter(current)
        if addedConnection then addedConnection:Disconnect(); addedConnection = nil end
        if removingConnection then removingConnection:Disconnect(); removingConnection = nil end
        table.clear(cachedParts)
        if not current then return end
        for _, part in ipairs(current:GetDescendants()) do
            if part:IsA("BasePart") then cachedParts[part] = true end
        end
        addedConnection = current.DescendantAdded:Connect(function(part)
            if part:IsA("BasePart") then cachedParts[part] = true end
        end)
        removingConnection = current.DescendantRemoving:Connect(function(part)
            cachedParts[part] = nil
        end)
    end
    local function restore()
        for part, collidable in pairs(originals) do
            if part.Parent then pcall(function() part.CanCollide = collidable end) end
        end
        table.clear(originals)
    end
    local function wanted()
        return T.noclipEnabled or T.noclipCarEnabled or T.vFlyEnabled or next(leases) ~= nil
    end
    local function step(force)
        local current = LocalPlayer.Character
        if character ~= current then
            restore()
            character = current
            watchCharacter(current)
        end
        if o.destroyed or not current or (force ~= true and not wanted()) then
            if next(originals) then restore() end
            return
        end
        for part in pairs(cachedParts) do
            if part.Parent then
                if originals[part] == nil then originals[part] = part.CanCollide end
                if part.CanCollide then part.CanCollide = false end
            end
        end
    end
    o.noclip = {
        acquire = function(owner) leases[owner] = true; step() end,
        release = function(owner) leases[owner] = nil; step() end,
        step = function() step() end,
        restore = function()
            table.clear(leases)
            restore()
            if o.destroyed then watchCharacter(nil); character = nil end
        end,
    }
    sz = function(force) step(force) end
    Nz = function() step() end
    ez = function() end
    o.sz, o.Nz, o.ez = sz, Nz, ez
    handleReady(LocalPlayer.CharacterAdded:Connect(function() step() end))
end

-- ============================================================
-- CAMUFLAR NICK (valor exato; sem substituições acumuladas)
-- ============================================================
do
    local NOME_FAKE = "@VETERANO.DEV"
    local bindings = {}
    local elapsed = 0

    local function bind(obj, prop)
        if not obj or bindings[obj] then return end
        local ok, original = pcall(function() return obj[prop] end)
        if not ok or type(original) ~= "string" then return end
        local entry = { original = original, prop = prop, writing = false }
        bindings[obj] = entry
        local function enforce()
            if entry.writing or not T.camuflarNickEnabled or o.destroyed or not obj.Parent then return end
            local text = obj[prop]
            if text == NOME_FAKE then return end
            entry.original = text
            entry.writing = true
            obj[prop] = NOME_FAKE
            entry.writing = false
        end
        entry.connection = obj:GetPropertyChangedSignal(prop):Connect(function() pcall(enforce) end)
        enforce()
    end

    local function discover()
        for obj, entry in pairs(bindings) do
            if not obj.Parent then
                entry.connection:Disconnect()
                bindings[obj] = nil
            end
        end
        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        local inventory = pg and pg:FindFirstChild("InventoryUI")
        local frame = inventory and inventory:FindFirstChild("InvFrame")
        local personal = frame and frame:FindFirstChild("InvPessoal")
        local name = personal and personal:FindFirstChild("BTxt")
        if name and (name:IsA("TextLabel") or name:IsA("TextButton") or name:IsA("TextBox")) then
            bind(name, "Text")
        end
        local hum = isCValid()
        if hum then bind(hum, "DisplayName") end
    end

    local function restore()
        for obj, entry in pairs(bindings) do
            entry.connection:Disconnect()
            if obj.Parent then pcall(function() obj[entry.prop] = entry.original end) end
        end
        table.clear(bindings)
    end

    function o.setCamuflarNick(v)
        T.camuflarNickEnabled = v == true
        if T.camuflarNickEnabled and not o.destroyed then
            discover()
        else
            restore()
        end
    end
    handleReady(RunService.Heartbeat:Connect(function(dt)
        if not T.camuflarNickEnabled or o.destroyed then return end
        elapsed = elapsed + dt
        if elapsed >= 0.35 then elapsed = 0; pcall(discover) end
    end))
end

