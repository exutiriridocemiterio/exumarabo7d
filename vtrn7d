local function AttachPortal(window, options)
    options = options or {}
    local root, scale = window.root, window.scale
    local initialVisible = not options.InitiallyHidden
    local dead, running, wanted, shown = false, false, initialVisible, initialVisible
    local destroyAfter = false
    local homePosition, homeScale, homeRotation = root.Position, 1, 0
    local activeTweens = {}
    local fadeSnapshot = {}
    local controlsSnapshot = {}
    local fxConnections = {}
    local originalDestroy = window.Destroy
    local readyAt = os.clock() + 0.34
    local function restoreClipping()
        root.Rotation = 0
        root.ClipsDescendants = true
        for _, object in ipairs(root:GetDescendants()) do
            if object:IsA("ScrollingFrame") then object.ClipsDescendants = true end
        end
    end
    restoreClipping()
    local fxGui = Instance.new("ScreenGui")
    fxGui.Name = "VeteranoPortalFX"
    fxGui.ResetOnSpawn = false
    fxGui.IgnoreGuiInset = true
    fxGui.DisplayOrder = window.gui.DisplayOrder + 1
    fxGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    fxGui.Parent = window.gui.Parent
    window.maid:Add(fxGui)
    window.maid:Add(function()
        dead = true
        for _, tw in ipairs(activeTweens) do tw:Cancel() end
        table.clear(activeTweens)
        for connection in pairs(fxConnections) do connection:Disconnect() end
        table.clear(fxConnections)
    end)

    local function cancelTweens()
        for _, tw in ipairs(activeTweens) do pcall(function() tw:Cancel() end) end
        table.clear(activeTweens)
    end

    local function animate(object, duration, properties, style, direction)
        local tw = TweenService:Create(object,
            TweenInfo.new(duration, style or Enum.EasingStyle.Quint,
                direction or Enum.EasingDirection.Out), properties)
        table.insert(activeTweens, tw)
        tw:Play()
        return tw
    end

    local function captureFade()
        table.clear(fadeSnapshot)
        local objects = root:GetDescendants()
        table.insert(objects, root)
        for _, object in ipairs(objects) do
            local values = {}
            if object:IsA("GuiObject") then
                values.BackgroundTransparency = object.BackgroundTransparency
            end
            if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
                values.TextTransparency = object.TextTransparency
                values.TextStrokeTransparency = object.TextStrokeTransparency
            end
            if object:IsA("ImageLabel") or object:IsA("ImageButton") then
                values.ImageTransparency = object.ImageTransparency
            end
            if object:IsA("UIStroke") then values.Transparency = object.Transparency end
            if next(values) then fadeSnapshot[object] = values end
        end
    end

    local function fade(alpha, duration, style, direction)
        for object, values in pairs(fadeSnapshot) do
            if object.Parent then
                local goal = {}
                for property, base in pairs(values) do
                    goal[property] = base + (1 - base) * alpha
                end
                if duration == 0 then
                    for property, value in pairs(goal) do object[property] = value end
                else
                    animate(object, duration, goal, style or Enum.EasingStyle.Sine, direction)
                end
            end
        end
    end

    local function lockControls()
        table.clear(controlsSnapshot)
        for _, object in ipairs(root:GetDescendants()) do
            if object:IsA("GuiObject") then
                local ok, value = pcall(function() return object.Interactable end)
                if ok then
                    controlsSnapshot[object] = value
                    pcall(function() object.Interactable = false end)
                end
            end
        end
    end
    local function unlockControls()
        for object, value in pairs(controlsSnapshot) do
            if object.Parent then pcall(function() object.Interactable = value end) end
        end
        table.clear(controlsSnapshot)
    end

    local function portal(point, closing, duration)
        if ReducedMotion then return end
        local group = Instance.new("Frame")
        group.BackgroundTransparency = 1
        group.Size = UDim2.fromOffset(1, 1)
        group.Position = UDim2.fromOffset(point.X, point.Y)
        group.Parent = fxGui
        Debris:AddItem(group, duration + 0.65)
        for i = 1, 3 do
            local ring = Instance.new("Frame")
            ring.AnchorPoint = Vector2.new(0.5, 0.5)
            ring.BackgroundTransparency = 1
            local startSize = closing and (140 + i * 28) or (10 + i * 4)
            ring.Size = UDim2.fromOffset(startSize, startSize)
            ring.Rotation = i * 32
            ring.Parent = group
            Instance.new("UICorner", ring).CornerRadius = UDim.new(1, 0)
            local outline = Instance.new("UIStroke")
            outline.Color = i == 1 and Color3.fromRGB(225, 199, 255) or ThemeAccent
            outline.Thickness = i == 1 and 2.5 or 1.2
            outline.Transparency = 0.2 + i * 0.12
            outline.Parent = ring
            local gradient = Instance.new("UIGradient")
            gradient.Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 1),
                NumberSequenceKeypoint.new(0.4, 0),
                NumberSequenceKeypoint.new(0.8, 0.2),
                NumberSequenceKeypoint.new(1, 1),
            })
            gradient.Parent = outline
            local finalSize = closing and 4 or (155 + i * 35)
            animate(ring, duration, {
                Size = UDim2.fromOffset(finalSize, finalSize),
                Rotation = ring.Rotation + (closing and 170 or -120),
            }, Enum.EasingStyle.Quart, closing and Enum.EasingDirection.In or Enum.EasingDirection.Out)
            animate(outline, duration, {Transparency = 1})
        end
        local flash = Instance.new("Frame")
        flash.AnchorPoint = Vector2.new(0.5, 0.5)
        flash.Size = UDim2.fromOffset(closing and 16 or 32, closing and 16 or 32)
        flash.BackgroundColor3 = Color3.fromRGB(235, 216, 255)
        flash.BackgroundTransparency = 0.12
        flash.BorderSizePixel = 0
        flash.Parent = group
        Instance.new("UICorner", flash).CornerRadius = UDim.new(1, 0)
        animate(flash, duration, {Size = UDim2.fromOffset(2, 2), BackgroundTransparency = 1})
        for i = 1, 16 do
            local angle = i / 16 * math.pi * 2
            local radius = 65 + (i % 4) * 18
            local offset = Vector2.new(math.cos(angle) * radius, math.sin(angle) * radius)
            local dot = Instance.new("Frame")
            dot.AnchorPoint = Vector2.new(0.5, 0.5)
            dot.Size = UDim2.fromOffset(i % 3 == 0 and 4 or 2, i % 3 == 0 and 4 or 2)
            dot.Position = closing and UDim2.fromOffset(offset.X, offset.Y) or UDim2.fromOffset(0, 0)
            dot.BackgroundColor3 = i % 3 == 0 and Color3.fromRGB(214, 182, 255) or ThemeAccent
            dot.BackgroundTransparency = 0.1
            dot.BorderSizePixel = 0
            dot.Parent = group
            Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)
            local target = closing and Vector2.zero or offset
            animate(dot, duration * 0.85, {
                Position = UDim2.fromOffset(target.X, target.Y),
                BackgroundTransparency = 1,
                Rotation = 130,
            }, Enum.EasingStyle.Quart, closing and Enum.EasingDirection.In or Enum.EasingDirection.Out)
        end
    end

    local function lerp(a, b, t) return a + (b - a) * t end
    local function bezier(a, b, c, t) return lerp(lerp(a, b, t), lerp(b, c, t), t) end
    local function blackHole(point, duration)
        local closing = true
        local C = {bg = ThemeBg, accent = ThemeAccent, bright = Color3.fromRGB(218, 194, 255)}
        local function frame(parent, name, position, size, color, transparency)
            local object = Instance.new("Frame")
            object.Name = name
            object.Position, object.Size = position, size
            object.BackgroundColor3 = color
            object.BackgroundTransparency = transparency or 0
            object.BorderSizePixel = 0
            object.Parent = parent
            return object
        end
        local function corner(parent, radius)
            local object = Instance.new("UICorner")
            object.CornerRadius = UDim.new(0, radius)
            object.Parent = parent
        end
        local function stroke(parent, color, transparency, thickness)
            local object = Instance.new("UIStroke")
            object.Color, object.Transparency, object.Thickness = color, transparency, thickness
            object.Parent = parent
            return object
        end
        local function gradient(parent, a, b, rotation)
            local object = Instance.new("UIGradient")
            object.Color = ColorSequence.new(a, b)
            object.Rotation = rotation
            object.Parent = parent
            return object
        end
        if ReducedMotion then return end
        local container = frame(fxGui, "Singularity", UDim2.fromOffset(point.X, point.Y), UDim2.fromOffset(1, 1), C.bg, 1)
        local rings = {}
        for i = 1, 4 do
            local ring = frame(container, "Lens", UDim2.fromOffset(0, 0), UDim2.fromOffset(1, 1), C.bg, 1)
            ring.AnchorPoint = Vector2.new(0.5, 0.5)
            corner(ring, 999)
            local edge = stroke(ring, i == 1 and C.bright or C.accent, 0.15 + i * 0.12, i == 1 and 2.5 or 1)
            local g = gradient(edge, C.bright, C.accent, i * 50)
            g.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.4, 0), NumberSequenceKeypoint.new(0.8, 0.3), NumberSequenceKeypoint.new(1, 1)})
            rings[i] = {ring, edge, g}
        end
        local coreFX = frame(container, "EventHorizon", UDim2.fromOffset(0, 0), UDim2.fromOffset(10, 10), C.bg)
        coreFX.AnchorPoint = Vector2.new(0.5, 0.5)
        corner(coreFX, 999)
        stroke(coreFX, C.bright, 0.2, 2)
        local stars = {}
        do
            for i = 1, 28 do
                local angle = i * 2.399963
                local radius = 54 + (i % 6) * 20
                local start = Vector2.new(math.cos(angle) * radius, math.sin(angle) * radius * 0.8)
                local bend = Vector2.new(-start.Y * 0.9, start.X * 0.9)
                local dot = frame(container, "Spark", UDim2.fromOffset(0, 0), UDim2.fromOffset(i % 4 == 0 and 4 or 2, i % 4 == 0 and 4 or 2), i % 4 == 0 and C.bright or C.accent)
                dot.AnchorPoint = Vector2.new(0.5, 0.5)
                corner(dot, 4)
                stars[i] = {dot, start, bend, (i % 5) * 0.025}
            end
        end
        local elapsed = 0
        local connection
        connection = RunService.RenderStepped:Connect(function(dt)
            if dead or window.Destroyed or not container.Parent then connection:Disconnect(); fxConnections[connection] = nil; return end
            elapsed = elapsed + dt
            local alpha = math.clamp(elapsed / duration, 0, 1)
            local progress = closing and (1 - alpha ^ 3) or (1 - (1 - alpha) ^ 3)
            for i, ring in ipairs(rings) do
                local diameter = 8 + (110 + i * 28) * progress
                ring[1].Size = UDim2.fromOffset(diameter, diameter * (i == 3 and 0.42 or 1))
                ring[1].Rotation = (closing and 1 or -1) * alpha * (130 + i * 24) + i * 30
                ring[2].Transparency = math.clamp(0.1 + i * 0.1 + alpha ^ 3, 0, 1)
                ring[3].Rotation = alpha * 240 + i * 30
            end
            local coreSize = closing and (6 + 24 * math.sin(alpha * math.pi)) or (28 * (1 - alpha) + 2)
            coreFX.Size = UDim2.fromOffset(coreSize, coreSize)
            coreFX.BackgroundTransparency = alpha ^ 3
            for _, spark in ipairs(stars) do
                local t = math.clamp((alpha - spark[4]) / (1 - spark[4]), 0, 1)
                local a = closing and spark[2] or Vector2.zero
                local c = closing and Vector2.zero or spark[2]
                local pos = bezier(a, spark[3], c, t)
                spark[1].Position = UDim2.fromOffset(pos.X, pos.Y)
                spark[1].BackgroundTransparency = math.clamp(t * t, 0, 1)
            end
            if alpha >= 1 then connection:Disconnect(); fxConnections[connection] = nil; container:Destroy() end
        end)
        fxConnections[connection] = true
    end

    local function transition(visible)
        cancelTweens()
        restoreClipping()
        if visible then
            root.Position, root.Rotation, scale.Scale = homePosition, homeRotation, homeScale
            if options.CenterOnOpen then options.CenterOnOpen(window) end
            homePosition, homeScale, homeRotation = root.Position, scale.Scale, 0
            if not next(fadeSnapshot) then captureFade() end
        else
            homePosition, homeScale, homeRotation = root.Position, scale.Scale, 0
            captureFade()
        end
        local duration = ReducedMotion and 0.14 or (visible and 0.58 or 0.65)
        local point
        if visible then
            root.Position = homePosition
            scale.Scale = homeScale
            root.Rotation = homeRotation
        end
        point = root.AbsolutePosition + Vector2.new(root.AbsoluteSize.X - 22, 26)
        local centre = root.AbsolutePosition + root.AbsoluteSize / 2
        local delta = point - centre
        local target = UDim2.new(homePosition.X.Scale, homePosition.X.Offset + delta.X,
            homePosition.Y.Scale, homePosition.Y.Offset + delta.Y)
        local tinyScale = ReducedMotion and homeScale * 0.96 or homeScale * 0.025
        if window.overlay then window.overlay:CloseAll() end
        if window.dock then window.dock.Visible = false end
        window.gui.Enabled = true
        root.Visible = true
        lockControls()
        if visible then
            scale.Scale = tinyScale
            root.Position = ReducedMotion and homePosition or target
            root.Rotation = 0
            fade(1, 0)
            portal(point, false, duration)
            animate(scale, duration, {Scale = homeScale},
                ReducedMotion and Enum.EasingStyle.Quint or Enum.EasingStyle.Back)
            animate(root, duration, {Position = homePosition})
            fade(0, duration * 0.6)
        else
            if not ReducedMotion then
                animate(scale, duration * 0.18, {Scale = homeScale * 1.018})
                task.wait(duration * 0.18)
                if dead or window.Destroyed then return end
                duration = duration * 0.82
            end
            blackHole(point, duration)
            animate(scale, duration, {Scale = tinyScale}, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
            animate(root, duration, {Position = ReducedMotion and homePosition or target},
                Enum.EasingStyle.Quint, Enum.EasingDirection.In)
            fade(1, duration, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        end
        task.wait(duration + 0.03)
        if dead or window.Destroyed then return end
        root.Visible = visible
        root.Position = homePosition
        root.Rotation = homeRotation
        scale.Scale = homeScale
        fade(0, 0)
        unlockControls()
        restoreClipping()
        if visible then
            window:_clampToViewport()
            window:_showDock(window.activeTab and window.activeTab:Root() or nil, false)
            window:_placeDock()
        end
        table.clear(activeTweens)
    end

    local function requestState(visible)
        if dead or window.Destroyed then return end
        wanted = visible
        window.Hidden = not visible
        if window.launcher then window.launcher:_paint() end
        if running then return end
        running = true
        task.spawn(function()
            local ok, problem = pcall(function()
                local remaining = readyAt - os.clock()
                if remaining > 0 then task.wait(remaining) end
                while not dead and not window.Destroyed and shown ~= wanted do
                    local target = wanted
                    transition(target)
                    shown = target
                end
            end)
            running = false
            if not ok and not dead and not window.Destroyed then
                cancelTweens()
                for connection in pairs(fxConnections) do connection:Disconnect() end
                table.clear(fxConnections)
                for _, child in ipairs(fxGui:GetChildren()) do child:Destroy() end
                pcall(function() fade(0, 0) end)
                unlockControls()
                root.Position, root.Rotation, scale.Scale = homePosition, homeRotation, homeScale
                restoreClipping()
                root.Visible, window.Hidden = wanted, not wanted
                window.gui.Enabled = true
                if window.dock then window.dock.Visible = false end
                shown = wanted
                warn("[VETERANO TEAM] Efeito visual recuperado: " .. tostring(problem))
            end
            if destroyAfter and not dead and not window.Destroyed then
                originalDestroy(window)
            end
        end)
    end

    function window:SetVisible(state)
        if not destroyAfter then requestState(state ~= false) end
        return self
    end
    function window:Close()
        return self:SetVisible(false)
    end
    function window:Toggle()
        return self:SetVisible(self.Hidden)
    end

    local controller = {}
    function controller:Destroy()
        if dead or window.Destroyed or destroyAfter then return end
        destroyAfter = true
        requestState(false)
    end
    if options.InitiallyHidden then
        window.Hidden, root.Visible, window.gui.Enabled = true, false, true
        if window.dock then window.dock.Visible = false end
        if window.launcher then window.launcher:_paint() end
    end
    return controller
end


