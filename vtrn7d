        attempt(key,false)
    end})
    section:Button({Name="Cancelar (Recusar Termos)",Icon="x",Callback=cancelLogin})
    if saved and keyLooksValid(cleanKey(saved)) then task.defer(function() attempt(saved,true) end) end
    while result==nil and not cancelled do task.wait(0.1) end
    if env.__VT_LOGIN_GUI==KW.gui then env.__VT_LOGIN_GUI=nil end
    if env.__VT_PORTAL_LOGIN_CANCEL==cancelLogin then env.__VT_PORTAL_LOGIN_CANCEL=nil end
    if not result or cancelled then
        if not KW.Destroyed then KW:Destroy() end
        return nil
    end
    return {Key=sessionKey,HWID=deviceHWID}
end)()

