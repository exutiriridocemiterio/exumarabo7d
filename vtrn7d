    local C = (getgenv and getgenv()) or _G
    local requestFn = request or http_request or (syn and syn.request)
        or (http and http.request) or (fluxus and fluxus.request)
    local readFn = readfile or C.readfile
    local writeFn = writefile or C.writefile
    local existsFn = isfile or C.isfile
    local makeFn = makefolder or C.makefolder
    local isFolderFn = isfolder or C.isfolder

    local session = { sent = false, sending = false, cancelled = false, status = "idle" }
    local FOLDER = "VeteranoTeam"
    local EDITION = "completa"
    local SCRIPT_VERSION = "menu-v12-login-sync-fixed"

    local function safeRead(path)
        if type(readFn) ~= "function" then return nil end
        local ok, value = pcall(function()
            if type(existsFn) == "function" and not existsFn(path) then return nil end
            return readFn(path)
        end)
        if ok and type(value) == "string" and #value <= 8192 then return value end
    end
    local function safeWrite(path, value)
        if type(writeFn) ~= "function" then return false end
        if type(makeFn) == "function" then
            local found = false
            if type(isFolderFn) == "function" then
                local ok, result = pcall(isFolderFn, FOLDER)
                found = ok and result == true
            end
            if not found then pcall(makeFn, FOLDER) end
        end
        return pcall(writeFn, path, value)
    end
    local function readValue(fn)
        local ok, value = pcall(fn)
        if ok and value ~= nil then return tostring(value) end
        return ""
    end
    local function decode(raw)
        if type(raw) ~= "string" or #raw > 131072 then return nil end
        local ok, result = pcall(HttpService.JSONDecode, HttpService, raw)
        if ok and type(result) == "table" then return result end
    end
    local function httpJSON(url, method, body)
        if type(requestFn) ~= "function" then return nil, "HTTP_INDISPONIVEL" end
        local headers = { Accept = "application/json" }
        if body then headers["Content-Type"] = "application/json" end
        local ok, response = pcall(requestFn, {
            Url = url, Method = method or "GET",
            Headers = headers, Body = body, Timeout = 10,
        })
        if not ok or type(response) ~= "table" then return nil, "FALHA_HTTP" end
        local code = tonumber(response.StatusCode or response.status_code or 0)
        for _ = 1, 3 do
            if code ~= 301 and code ~= 302 and code ~= 303 and code ~= 307 and code ~= 308 then break end
            local location
            for k, v in pairs(response.Headers or response.headers or {}) do
                if tostring(k):lower() == "location" then location = tostring(v); break end
            end
            if not location or not location:match("^https://script%.googleusercontent%.com/") then break end
            ok, response = pcall(requestFn, {
                Url = location, Method = "GET",
                Headers = { Accept = "application/json" }, Timeout = 10,
            })
            if not ok or type(response) ~= "table" then return nil, "FALHA_REDIRECIONAMENTO" end
            code = tonumber(response.StatusCode or response.status_code or 0)
        end
        if code < 200 or code >= 300 then return nil, "HTTP_" .. tostring(code) end
        local raw = response.Body or response.body
        if type(raw) ~= "string" then return nil, "RESPOSTA_INVALIDA" end
        return decode(raw), nil
    end
    local function identifier()
        if VTUI.Auth and type(VTUI.Auth.HWID) == "string" and VTUI.Auth.HWID ~= "" then
            return VTUI.Auth.HWID
        end
        local file = FOLDER .. "/hwid_" .. tostring(player.UserId) .. ".txt"
        local value = safeRead(file)
        if value and #value > 0 and #value <= 256 then return value end
        value = HttpService:GenerateGUID(false) .. "-" .. tostring(player.UserId)
        safeWrite(file, value)
        return value
    end
    local function collect()
        local data = {
            event_id = HttpService:GenerateGUID(false),
            key = (VTUI.Auth and VTUI.Auth.Key) or safeRead(FOLDER .. "/key.txt") or "",
            hwid = identifier(),
            roblox_id = tostring(player.UserId),
