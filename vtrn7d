local function normalizarNomeRaw(nome)
    if not nome then return "" end
    local n = tostring(nome)
    n = n:gsub("[áàãâä]", "a"):gsub("[éèêë]", "e"):gsub("[íìîï]", "i")
    n = n:gsub("[óòõôö]", "o"):gsub("[úùûü]", "u"):gsub("ç", "c")
    return n:lower():gsub("[^%w]", "")
end

local nomeCache, nomeCacheN = {}, 0
local function normalizarNome(nome)
    if not nome then return "" end
    local k = tostring(nome)
    local c = nomeCache[k]
    if c then return c end
    local r = normalizarNomeRaw(k)
    if nomeCacheN > 2000 then nomeCache, nomeCacheN = {}, 0 end
    nomeCache[k] = r
    nomeCacheN = nomeCacheN + 1
    return r
end

local function ehArmaPermitidaRaw(nome)
    local key = normalizarNome(nome)
    if key == "" then return false end
    if WHITELIST_ARMAS[key] then return true end
    for arma in pairs(WHITELIST_ARMAS) do
        if (#arma >= 4 and key:find(arma, 1, true)) or (#arma <= 3 and key:match("^" .. arma .. "%d*$")) then return true end
    end
    return false
end
local armaCache, armaCacheN = {}, 0
local function ehArmaPermitida(nome)
    local k = tostring(nome or "")
    local c = armaCache[k]
    if c ~= nil then return c end
    local r = ehArmaPermitidaRaw(nome) and true or false
    if armaCacheN > 2000 then armaCache, armaCacheN = {}, 0 end
    armaCache[k] = r
    armaCacheN = armaCacheN + 1
    return r
end
o.ehArmaPermitida = ehArmaPermitida

