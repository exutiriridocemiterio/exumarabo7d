            end
        end
    end)
    handleReady(LocalPlayer.CharacterAdded:Connect(function()
        inventoryBaseline, warmUntil = nil, os.clock() + 0.75
    end))
    inventoryBaseline = snapshot()
    function o.cleanupCollection() enabled = false; o.stopAutoColeta() end
