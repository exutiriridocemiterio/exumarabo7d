-- FLY / SPEED / TP: teclado, controle e joystick nativo; sem hooks do jogo.
do
    local flyConnection, speedConnection, controls
    local flyRoot, flyHumanoid, flyCharacter, speedRoot
    local flySpeed, speedSpeed = tonumber(T.flySpeed) or 1.5, tonumber(T.spoofWalkSpeed) or 5
    local teleport, jumpUntil = nil, 0
    local flyGeneration = 0
    local function syncControls()
        if o.flyControl then o.flyControl:Set(T.flyEnabled, true) end
        if o.speedControl then o.speedControl:Set(T.spoofWalkEnabled, true) end
    end
    local function stopFly()
        flyGeneration = flyGeneration+1
        T.flyEnabled = false
        if flyConnection then flyConnection:Disconnect(); flyConnection = nil end
        if flyRoot then pcall(function() flyRoot.Anchored = false end) end
        if flyHumanoid then pcall(function() flyHumanoid.PlatformStand = false end) end
        if flyCharacter then pcall(function()
            local hl = flyCharacter:FindFirstChild("FlyHighlight")
            if hl then hl:Destroy() end
        end) end
        flyRoot, flyHumanoid, flyCharacter = nil, nil, nil
        jumpUntil = 0
    end
    local function stopSpeed()
        T.spoofWalkEnabled = false
        if speedConnection then speedConnection:Disconnect(); speedConnection = nil end
        if speedRoot then pcall(function() speedRoot.Anchored = false end) end
        speedRoot = nil
    end
    function o.stopMovement()
        stopFly(); stopSpeed(); syncControls()
    end
    local function ready(mode)
        if o.destroyed then return false end
        if o.fixedTeleportBusy or teleport then Xz("Aguarde o teleporte terminar."); return false end
        if o.claimFarm and not o.claimFarm(mode) then return false end
        if o.garage then o.garage.cancel() end
        if o.travel and o.travel.owner then Xz("Aguarde o deslocamento terminar."); return false end
        local root, hum = isRoot(), isCValid()
        if not root or not hum or hum.Health <= 0 then Xz("Aguarde o personagem carregar."); return false end
        if hum.Sit or hum.SeatPart or root.Anchored then Xz("Saia do assento e aguarde o personagem ser liberado."); return false end
        return true
    end
    local function loadControls()
        if controls then return end
        local scripts = LocalPlayer:FindFirstChild("PlayerScripts")
        local module = scripts and scripts:FindFirstChild("PlayerModule")
        if module then
            local ok, result = pcall(function() return require(module):GetControls() end)
            if ok and result and type(result.GetMoveVector) == "function" then controls = result end
        end
    end
    -- Retorna movimento relativo a camera, preservando a intensidade analogica.
    function o.flyInput(camera, humanoid)
        if UserInputService:GetFocusedTextBox() then return Vector3.zero end
        local input, world = Vector3.zero, false
        if controls then
            local ok, value = pcall(controls.GetMoveVector, controls)
            if ok and typeof(value) == "Vector3" then input = value end
        end
        if input.Magnitude < 0.001 then
            for _, key in ipairs(UserInputService:GetKeysPressed()) do
                if key.KeyCode == Enum.KeyCode.W then input = input + Vector3.new(0,0,-1)
                elseif key.KeyCode == Enum.KeyCode.S then input = input + Vector3.new(0,0,1)
                elseif key.KeyCode == Enum.KeyCode.A then input = input + Vector3.new(-1,0,0)
                elseif key.KeyCode == Enum.KeyCode.D then input = input + Vector3.new(1,0,0) end
            end
            if input.Magnitude < 0.001 and humanoid.MoveDirection.Magnitude > 0 then
                input, world = humanoid.MoveDirection, true
            end
        end
        local move = world and input or camera.CFrame.RightVector * input.X + camera.CFrame.LookVector * -input.Z
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) or os.clock() < jumpUntil then move = move + Vector3.new(0,1,0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then move = move - Vector3.new(0,1,0) end
        return move.Magnitude > 1 and move.Unit or move
    end
    function o.setFly(value)
        if value ~= true then stopFly(); syncControls(); return true end
        if flyConnection then return true end
        if not ready("fly") then T.flyEnabled = false; syncControls(); return false end
        stopSpeed()
        local generation = flyGeneration
        loadControls()
        -- require pode ceder a execucao; confirme novamente o personagem.
        if generation ~= flyGeneration or o.destroyed or o.fixedTeleportBusy or (o.travel and o.travel.owner) then return false end
        local char, root, hum = LocalPlayer.Character, isRoot(), isCValid()
        if not char or not root or not hum or hum.Health <= 0 or hum.SeatPart or root.Anchored then return false end
        flyCharacter, flyRoot, flyHumanoid = char, root, hum
        local ok, problem = pcall(function()
            root.Anchored, hum.PlatformStand = true, true
            local hl = Instance.new("Highlight")
            hl.Name, hl.FillColor, hl.OutlineColor = "FlyHighlight", Color3.fromRGB(0,255,128), Color3.fromRGB(0,255,0)
            hl.FillTransparency, hl.Parent = 0.5, char
            T.flyEnabled = true
            flyConnection = RunService.RenderStepped:Connect(LPH_NO_VIRTUALIZE(function(dt)
                if o.destroyed or LocalPlayer.Character ~= char or not root.Parent or hum.Health <= 0 then
                    stopFly(); syncControls(); return
                end
                local camera = workspace.CurrentCamera
                if not camera then return end
                local move = o.flyInput(camera, hum)
                if move.Magnitude > 0 then
                    root.CFrame = root.CFrame + move * flySpeed * (math.clamp(dt, 0, 1/15) * 60)
                end
            end))
        end)
        if not ok then stopFly(); Xz("Fly: " .. tostring(problem)) end
        syncControls()
        return ok
    end
    function o.setSpeed(value)
        if value ~= true then stopSpeed(); syncControls(); return true end
        if speedConnection then return true end
        if not ready("speed") then T.spoofWalkEnabled = false; syncControls(); return false end
        stopFly()
        local char, root, hum = LocalPlayer.Character, isRoot(), isCValid()
        speedRoot, T.spoofWalkEnabled = root, true
        speedConnection = RunService.RenderStepped:Connect(LPH_NO_VIRTUALIZE(function(dt)
            if o.destroyed or LocalPlayer.Character ~= char or not root.Parent or hum.Health <= 0 then
                stopSpeed(); syncControls(); return
            end
            local move = hum.MoveDirection
            if not UserInputService:GetFocusedTextBox() and move.Magnitude > 0 then
                root.Anchored = false
                root.CFrame = root.CFrame + move * speedSpeed * (math.clamp(dt, 0, 1/15) * 60)
            end
            root.Anchored = true
        end))
        syncControls()
        return true
    end
    function o.setFlySpeed(value)
        value = tonumber(value)
        if value and value == value then flySpeed = math.clamp(value,0.5,10); T.flySpeed = flySpeed end
    end
    function o.setSpeedSpeed(value)
        value = tonumber(value)
        if value and value == value then speedSpeed = math.clamp(value,0.5,20); T.spoofWalkSpeed = speedSpeed end
    end
    local function release(operation)
        if not operation or operation.released then return end
        operation.released = true
        pcall(function() operation.root.Anchored = operation.wasAnchored end)
        pcall(function()
            if operation.hum.Parent and operation.hum.Health > 0 then
                operation.hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            end
        end)
    end
    -- Destino e a posicao exata da raiz. Apenas a UI de locais adiciona +3 studs.
    -- A mesma operacao atende locais, coleta, lixeiro e garagem, sem desativar colisoes.
    function o.teleportDirect(target, active)
        if teleport or o.destroyed then return false, "Outro teleporte esta em andamento." end
        if typeof(target) ~= "Vector3" or target.X ~= target.X or target.Y ~= target.Y or target.Z ~= target.Z
            or math.abs(target.X)+math.abs(target.Y)+math.abs(target.Z) == math.huge then
            return false, "Destino invalido."
        end
        local char, root, hum = LocalPlayer.Character, isRoot(), isCValid()
        if not root or not hum or hum.Health <= 0 then return false, "Personagem indisponivel." end
        if root.Anchored or hum.Sit or hum.SeatPart then return false, "Personagem preso ou sentado." end
        local op = {root=root, hum=hum, wasAnchored=root.Anchored, cancelled=false}
        teleport = op
        local function running()
            return not op.cancelled and not o.destroyed and LocalPlayer.Character == char
                and root.Parent and hum.Parent and hum.Health > 0 and (not active or active())
        end
        local ok, moved, reason = pcall(function()
            if not running() then return false, "Teleporte cancelado." end
            root.AssemblyLinearVelocity, root.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
            root.Anchored = true
            hum:ChangeState(Enum.HumanoidStateType.Physics)
            root.CFrame = CFrame.new(target)
            local deadline = os.clock()+0.3
            repeat
                task.wait(0.05)
                if not running() then return false, "Teleporte cancelado." end
            until os.clock() >= deadline
            release(op)
            task.wait(0.2)
            if not running() then return false, "Teleporte cancelado." end
            if (root.Position-target).Magnitude > 6 then return false, "O jogo recusou o teleporte." end
            return true
        end)
        release(op)
        if teleport == op then teleport = nil end
        if not ok then return false, "Falha no teleporte: "..tostring(moved) end
        return moved, reason
    end
    function o.teleportLocation(target, name)
        if o.destroyed or o.fixedTeleportBusy then return false end
        o.fixedTeleportBusy = true
        local ok, moved, reason = pcall(function()
            if o.config then o.config.cancelPendingLoad() end
            if o.claimFarm then o.claimFarm("teleport") else o.stopMovement() end
            if o.garage then o.garage.cancel() end
            local deadline = os.clock()+2
            while o.travel and o.travel.owner and not o.destroyed and os.clock()<deadline do task.wait(0.05) end
            if o.travel and o.travel.owner then return false, "Aguarde o deslocamento terminar." end
            o.travelBusy = true
            return o.teleportDirect(target+Vector3.new(0,3,0))
        end)
        o.fixedTeleportBusy = false
        if not (o.travel and o.travel.owner) then o.travelBusy = false end
        if not ok then reason, moved = tostring(moved), false end
        if not o.destroyed then Xz(moved and ("Teleporte executado: "..tostring(name or "destino")) or reason or "Teleporte cancelado.") end
        return moved == true, reason
    end
    function o.cleanupMovement()
        o.stopMovement()
        if teleport then teleport.cancelled = true; release(teleport) end
    end
    handleReady(UserInputService.JumpRequest:Connect(function()
        if T.flyEnabled then jumpUntil = os.clock()+0.25 end
    end))
    handleReady(LocalPlayer.CharacterRemoving:Connect(function() o.cleanupMovement() end))
end

