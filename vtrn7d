    })

    local saved=readOwn(CFG.LOGIN_STATE_FILE)==initializedValue and readOwn(CFG.KEY_FILE) or nil
    local keyControl,loginButton
    local statusControl=section:Label({Name="Insira sua key de acesso."})
    
    local function status(message,tone)
        if KW.Destroyed then return end
        statusControl:SetName(message)
        if tone then
            S:Notify({Title="Autenticação",Description=message,Tone=tone,Duration=4})
        end
    end
    local function resetButton()
        busy=false
        if loginButton and not KW.Destroyed then loginButton:SetName("Aceitar e Entrar") end
    end
    local function attempt(raw,silent)
        if busy or result~=nil or cancelled or KW.Destroyed then return end
        if os.clock()<lockedUntil then
            status("Muitas tentativas. Aguarde "..math.ceil(lockedUntil-os.clock()).."s.","Warning"); return
        end
        local key=cleanKey(raw)
        if key=="" then status("Cole sua key primeiro.","Warning"); return end
        if not keyLooksValid(key) then status("Formato de key inválido.","Danger"); return end
        busy=true
        loginButton:SetName("Verificando...")
        status(silent and "Validando licença..." or "Consultando servidor...")
        task.spawn(function()
            local ran,ok,message=pcall(validateRemote,key)
            if cancelled or KW.Destroyed or result~=nil then return end
            if not ran then ok,message=false,"Falha na conexão com a API. Tente novamente." end
            if ok then
                authorized,sessionKey=true,key
                writeOwn(CFG.KEY_FILE,key)
                status("Termos Aceitos e Acesso Liberado!","Success")
                loginButton:SetName("Liberado")
                task.wait(0.5)
                if cancelled or result~=nil then return end
                LoginPortal:Destroy()
                local deadline=os.clock()+3
                while not KW.Destroyed and not cancelled and os.clock()<deadline do task.wait(0.05) end
                if not KW.Destroyed then KW:Destroy() end
                if not cancelled then
                    writeOwn(CFG.LOGIN_STATE_FILE,initializedValue)
                    result=true
                end
                resetButton()
                return
            end
            resetButton()
            fails=fails+1
            if fails>=CFG.MAX_TRIES then
                fails,lockedUntil=0,os.clock()+CFG.LOCK_SECS
                status("Muitas tentativas. Aguarde "..CFG.LOCK_SECS.."s.","Warning")
            else
                status(message or "Key inválida ou expirada.",silent and "Warning" or "Danger")
            end
        end)
    end
    keyControl=section:Input({
        Name="Key de Acesso",Placeholder="VTRN-XXXX-XXXX",Default=saved and cleanKey(saved) or "",
        OnEnter=function(key) attempt(key,false) end,Callback=function() end,
    })
    loginButton=section:Button({Name="Aceitar e Entrar",Icon="check",Callback=function()
