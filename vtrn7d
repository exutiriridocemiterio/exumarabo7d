    if flyActive then pcall(toggleFly) end
    flyActive, T.flyEnabled = false, false
    if flyConnection then flyConnection:Disconnect(); flyConnection = nil end
    removeFlyTouch()
    if flyRoot then pcall(function() flyRoot.Anchored = false end) end
    if flyHumanoid then pcall(function() flyHumanoid.PlatformStand = false end) end
    if flyCharacter then
        pcall(function()
            local highlight = flyCharacter:FindFirstChild("FlyHighlight")
            if highlight then highlight:Destroy() end
        end)
    end
    flyRoot, flyHumanoid, flyCharacter = nil, nil, nil
end

local function stopSpeed()
    if speedActive then pcall(toggleSpeed) end
    speedActive, T.spoofWalkEnabled = false, false
    if speedConnection then speedConnection:Disconnect(); speedConnection = nil end
    if speedRoot then pcall(function() speedRoot.Anchored = false end) end
    speedRoot = nil
end

function o.stopMovement()
    stopFly()
    stopSpeed()
    syncControls()
end

local function readyToEnable(mode)
    if o.destroyed then return false end
    if o.fixedTeleportBusy then Xz("Aguarde o teleporte terminar."); return false end
    if o.claimFarm and not o.claimFarm(mode) then return false end
    if o.travel and o.travel.owner then
        Xz("Aguarde o deslocamento atual parar e ative novamente.")
        return false
    end
    local root, hum = isRoot(), isCValid()
    if not root or not hum or hum.Health <= 0 then
        Xz("Aguarde o personagem carregar.")
        return false
    end
    if hum.Sit or hum.SeatPart then Xz("Saia do assento antes de ativar."); return false end
    if root.Anchored then Xz("Aguarde o personagem ser liberado."); return false end
    return true
end

function o.setFly(value)
    if value ~= true then stopFly(); syncControls(); return true end
    if flyActive and not o.destroyed then return true end
    if not readyToEnable("fly") then T.flyEnabled = false; syncControls(); return false end
    stopSpeed()
    flyCharacter, flyRoot, flyHumanoid = LocalPlayer.Character, isRoot(), isCValid()
    local ok, problem = pcall(toggleFly)
    if not ok then stopFly(); Xz("Fly: " .. tostring(problem)) end
    T.flyEnabled = flyActive
    syncControls()
    return ok and flyActive
end

function o.setSpeed(value)
    if value ~= true then stopSpeed(); syncControls(); return true end
    if speedActive and not o.destroyed then return true end
    if not readyToEnable("speed") then T.spoofWalkEnabled = false; syncControls(); return false end
    stopFly()
    speedRoot = isRoot()
    local ok, problem = pcall(toggleSpeed)
    if not ok then stopSpeed(); Xz("Speed: " .. tostring(problem)) end
    T.spoofWalkEnabled = speedActive
    syncControls()
    return ok and speedActive
end

function o.setFlySpeed(value)
    local number = tonumber(value)
    if not number or number ~= number then return end
    flySpeed = math.clamp(number, 0.5, 1)
    T.flySpeed = flySpeed
end

function o.setSpeedSpeed(value)
    local number = tonumber(value)
    if not number or number ~= number then return end
    speedSpeed = math.clamp(number, 0.5, 2)
    T.spoofWalkSpeed = speedSpeed
end

local function releaseTeleport()
    if teleportRoot then pcall(function() teleportRoot.Anchored = false end) end
    if teleportHumanoid then
        pcall(function() teleportHumanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end)
    end
    teleportRoot, teleportHumanoid = nil, nil
end

function o.teleportLocation(targetPos, name)
    if o.destroyed or o.fixedTeleportBusy then return false end
    o.fixedTeleportBusy = true
    teleportThread = coroutine.running()
    local root, hum, character
    local ok, moved, reason = pcall(function()
        if o.config then o.config.cancelPendingLoad() end
        if o.claimFarm then o.claimFarm("teleport") else o.stopMovement() end
            local deadline = os.clock() + 2
        while o.travel and o.travel.owner and not o.destroyed and os.clock() < deadline do
            task.wait(0.05)
        end
        if o.destroyed then return false end
        if o.travel and o.travel.owner then return false, "Aguarde o deslocamento atual terminar." end
        root, hum, character = isRoot(), isCValid(), LocalPlayer.Character
        if not root or not hum or hum.Health <= 0 then return false, "Aguarde o personagem carregar." end
        if hum.Sit or hum.SeatPart then return false, "Saia do assento antes de teleportar." end
        if root.Anchored then return false, "Aguarde o personagem ser liberado." end
        teleportRoot, teleportHumanoid = root, hum
        o.travelBusy = true
        teleportToPosition(targetPos)
        teleportRoot, teleportHumanoid = nil, nil
        if o.destroyed or LocalPlayer.Character ~= character then return false end
        return true
    end)
    if not ok then releaseTeleport() end
    teleportThread = nil
    o.fixedTeleportBusy = false
    if not (o.travel and o.travel.owner) then o.travelBusy = false end
    if not o.destroyed then
        if not ok then Xz("Teleporte: " .. tostring(moved))
        elseif moved then Xz("Teleporte executado: " .. tostring(name or "destino"))
        elseif reason then Xz(reason) end
    end
    return ok and moved == true
end

function o.cleanupMovement()
    o.stopMovement()
    local pending = teleportThread
    teleportThread = nil
    if pending and pending ~= coroutine.running() and type(task.cancel) == "function" then
        pcall(task.cancel, pending)
    end
    releaseTeleport()
    o.fixedTeleportBusy = false
    if not (o.travel and o.travel.owner) then o.travelBusy = false end
end

handleReady(LocalPlayer.CharacterRemoving:Connect(function()
    o.cleanupMovement()
end))
end

