        if tabPlayer.Destroyed or not tabPlayer.icon or not tabPlayer.label then return end
        local icon, label = tabPlayer.icon, tabPlayer.label
        if not icon.Parent or not label.Parent then return end
        if S.Motion and type(S.Motion.cancel) == "function" then pcall(S.Motion.cancel, icon) end
