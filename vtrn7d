do
    local I = {}
    o.interact = I
    function I.position(prompt)
        local parent = prompt and prompt.Parent
        if not parent then return nil end
        if parent:IsA("Attachment") then return parent.WorldPosition end
        if parent:IsA("BasePart") then return parent.Position end
        if parent:IsA("Model") then return parent:GetPivot().Position end
        local part = parent:FindFirstAncestorWhichIsA("BasePart")
        return part and part.Position
    end
    function I.prompt(prompt, active, nativeOnly)
        local root = isRoot()
        local position = I.position(prompt)
        if not root or not position or not prompt.Enabled then return false end
        if (root.Position - position).Magnitude > prompt.MaxActivationDistance then return false end
        if active and not active() then return false end
        if prompt.RequiresLineOfSight then
            local ray = RaycastParams.new()
            ray.FilterType = Enum.RaycastFilterType.Exclude
            ray.FilterDescendantsInstances = {LocalPlayer.Character}
            local hit = workspace:Raycast(root.Position, position-root.Position, ray)
            local parent = prompt.Parent
            if parent and parent:IsA("Attachment") then parent = parent.Parent end
            if hit and parent and hit.Instance ~= parent and not hit.Instance:IsDescendantOf(parent) then return false end
        end
        local began = pcall(function() prompt:InputHoldBegin() end)
        if not began then return false end
        local deadline = os.clock() + math.max(prompt.HoldDuration, 0) + 0.1
        repeat
            local currentRoot, currentPosition = isRoot(), I.position(prompt)
            if not currentRoot or not currentPosition or (currentRoot.Position-currentPosition).Magnitude > prompt.MaxActivationDistance
                or not prompt.Parent or not prompt.Enabled or (active and not active()) then
                pcall(function() prompt:InputHoldEnd() end)
                return false
            end
            task.wait(0.04)
        until os.clock() >= deadline
        return pcall(function() prompt:InputHoldEnd() end)
    end

    function o.teleportCharacter(cf)
        if o.fixedTeleportBusy then return false end
        local char, root = LocalPlayer.Character, isRoot()
        if not char or not root or root.Anchored then return false end
        local offset = root.CFrame:ToObjectSpace(char:GetPivot())
        char:PivotTo(cf * offset)
        root.AssemblyLinearVelocity, root.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
        return true
    end

    -- Procura chao e volume livre perto do alvo; nunca desliga CanCollide.
    function o.findLanding(position, reach, target, preferred)
        local root, hum, char = isRoot(), isCValid(), LocalPlayer.Character
        if not root or not hum or not char or not position then return nil end
        reach = math.max(0, tonumber(reach) or 10)
        if reach < 0.5 then return nil end
        local hip = hum.HipHeight + root.Size.Y*0.5
        if hum.RigType == Enum.HumanoidRigType.R6 then hip = hip+2 end
        hip = math.clamp(hip, 2.5, 6)
        local ray = RaycastParams.new()
        ray.FilterType = Enum.RaycastFilterType.Exclude
        ray.FilterDescendantsInstances = target and {char,target} or {char}
        ray.RespectCanCollide = true
        local overlap = OverlapParams.new()
        overlap.FilterType = Enum.RaycastFilterType.Exclude
        overlap.FilterDescendantsInstances = {char}
        overlap.RespectCanCollide = true
        overlap.CollisionGroup = root.CollisionGroup
        local points = {}
        if preferred then points[#points+1] = preferred end
        points[#points+1] = position
        for _, radius in ipairs({math.min(3,reach*0.45), math.min(6,reach*0.75), reach*0.9}) do
            for i=0,7 do
                local angle = i*math.pi/4
                points[#points+1] = position+Vector3.new(math.cos(angle)*radius,0,math.sin(angle)*radius)
            end
        end
        for _, point in ipairs(points) do
            local ground = workspace:Raycast(point+Vector3.new(0,6,0),Vector3.new(0,-22,0),ray)
            if ground and ground.Normal.Y >= 0.65 then
                local landing = Vector3.new(point.X,ground.Position.Y+hip+0.15,point.Z)
                if (landing-position).Magnitude <= reach and landing.Y > workspace.FallenPartsDestroyHeight+10 then
                    local size = Vector3.new(math.max(2.5,root.Size.X+0.5), hip+2, math.max(2,root.Size.Z+0.5))
                    local center = landing+Vector3.new(0,(2-hip)*0.5+0.2,0)
                    local blocked = false
                    for _, part in ipairs(workspace:GetPartBoundsInBox(CFrame.new(center),size,overlap)) do
                        if part.CanCollide then blocked = true; break end
                    end
                    if not blocked then return landing end
                end
            end
        end
        return nil
    end

    local M = {owner=nil, token=0}
    o.travel = M
    function M.cancel(owner)
        if owner == nil or owner == M.owner then M.token = M.token+1 end
    end
    function M.to(owner, destination, active)
        if M.owner or o.fixedTeleportBusy then return false,"Outro deslocamento esta em andamento." end
        if T.noclipEnabled or T.noclipCarEnabled or T.vFlyEnabled then return false,"Desative o noclip antes do deslocamento." end
        if T.flyEnabled or T.spoofWalkEnabled or T.ghostEnabled then return false,"Desative Fly, Speed e Ghost antes do deslocamento." end
        M.owner, M.token, o.travelBusy = owner, M.token+1, true
        local token = M.token
        local function running() return not o.destroyed and M.token==token and (not active or active()) end
        local ok, moved, reason = pcall(function()
            if not running() then return false,"Deslocamento cancelado." end
            local position = destination
            if type(destination)=="function" then position = destination() end
            if not position then return false,"Destino indisponivel." end
            return o.teleportDirect(position,running)
        end)
        M.owner, o.travelBusy = nil, false
        if not ok then return false,"Falha no deslocamento: "..tostring(moved) end
        return moved,reason
    end

end

