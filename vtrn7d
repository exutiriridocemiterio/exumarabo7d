local function readOwn(path)
    if type(readFn) ~= "function" then return nil end
    local ok, value = pcall(function()
        if type(existsFn) == "function" and not existsFn(path) then return nil end
        return readFn(path)
    end)
    if ok and type(value) == "string" and #value <= 8192 then return value end
end
local function writeOwn(path, value)
    if type(writeFn) ~= "function" then return false end
    local make, exists = makefolder or env.makefolder, isfolder or env.isfolder
    if type(make) == "function" then
        local ok, found = false, false
        if type(exists) == "function" then ok, found = pcall(exists, "VeteranoTeam") end
        if not ok or not found then pcall(make, "VeteranoTeam") end
    end
    return pcall(writeFn, path, value)
end
local function getIdentifier()
    local value = readOwn(CFG.HWID_FILE)
        or readOwn("VeteranoTeam/registro_id_"..tostring(player.UserId)..".txt")
    if not value or value == "" or #value > 256 then
        value = HttpService:GenerateGUID(false).."-"..tostring(player.UserId)
    end
    writeOwn(CFG.HWID_FILE, value)
    return value
end
local function cleanKey(value)
    return (tostring(value or ""):gsub("%s+",""):upper())
end
local function keyLooksValid(key)
    return #key <= 200 and key:match("^VTRN%-[A-Z0-9]+%-[A-Z0-9]+$") ~= nil
end
local function decodeResponse(raw)
    if type(raw) ~= "string" or #raw > 131072 then return nil end
    raw = raw:gsub("^"..string.char(239,187,191), "")
    local ok, data = pcall(HttpService.JSONDecode, HttpService, raw)
    if ok and type(data) == "table" then return data end
end
local function validateRemote(key)
    deviceHWID = deviceHWID or getIdentifier()
    local payload = {action="validate", secret=CFG.VALIDATE_TOKEN, key=key, hwid=deviceHWID,
        userid=tostring(player.UserId), robloxId=tostring(player.UserId),
        robloxName=player.Name, username=player.Name}
    local query = {}
    for _, name in ipairs({"action","secret","key","hwid","userid","robloxId","robloxName","username"}) do
        table.insert(query, name.."="..HttpService:UrlEncode(payload[name]))
    end
    table.insert(query, "request_id="..HttpService:UrlEncode(HttpService:GenerateGUID(false)))
    local validationUrl = CFG.API_URL.."?"..table.concat(query, "&")
    local raw, code
    if type(requestFn) == "function" then
        local ok, response = pcall(requestFn, {Url=validationUrl, Method="GET", Timeout=15,
            Headers={Accept="application/json", ["Cache-Control"]="no-cache, no-store", Pragma="no-cache"}})
        if not ok or type(response) ~= "table" then return false, "Falha na conexão com a API. Tente novamente." end
        code = tonumber(response.StatusCode or response.status_code) or 0
        for _ = 1, 3 do
            if code ~= 301 and code ~= 302 and code ~= 303 and code ~= 307 and code ~= 308 then break end
            if cancelled or (KW and KW.Destroyed) then return false, "Login cancelado." end
            local location
            for name, value in pairs(response.Headers or response.headers or {}) do
                if tostring(name):lower() == "location" then location = tostring(value); break end
            end
            if not location or not location:match("^https://script%.googleusercontent%.com/") then
                return false, "Redirecionamento inesperado da API."
            end
            ok, response = pcall(requestFn, {Url=location, Method="GET", Timeout=15, Headers={Accept="application/json"}})
            if not ok or type(response) ~= "table" then return false, "Falha ao receber a resposta da API." end
            code = tonumber(response.StatusCode or response.status_code) or 0
        end
        raw = response.Body or response.body
    else
        local ok, response = pcall(function() return game:HttpGet(validationUrl) end)
        if not ok then return false, "Este executor não conseguiu acessar a API de login." end
        raw, code = response, 200
    end
    if code < 200 or code >= 300 then return false, "Servidor HTTP "..tostring(code)..". Tente novamente." end
    local data = decodeResponse(raw)
    if not data then return false, "Servidor sem JSON. Confira a implantação do Apps Script." end
    if data.ok == true and data.service == nil and (data.action == nil or data.action == "validate") then
        return true, "Key válida."
